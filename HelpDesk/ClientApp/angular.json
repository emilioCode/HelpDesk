{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "HelpDesk": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "tsConfig": "src/tsconfig.app.json",
            "progress": true,
            "polyfills": ["zone.js"],
            "assets": [
              "src/assets",
              { "glob": "{favicon.svg,favicon-32.png,apple-touch-icon.png,site.webmanifest}", "input": "src", "output": "/" },
              { "glob": "*.png", "input": "src/icons", "output": "/icons" }
            ],
            "styles": [
              "src/styles/tokens.css",
              "src/styles/ui.css",
              "src/styles/mobile.css",
              "@fontsource/inter/latin-400.css",
              "@fontsource/inter/latin-500.css",
              "@fontsource/inter/latin-600.css",
              "@fontsource/inter/latin-700.css",
              "src/styles.css",
              "node_modules/admin-lte/bower_components/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/admin-lte/dist/css/AdminLTE.min.css",
              "node_modules/admin-lte/bower_components/Ionicons/css/ionicons.min.css",
              "node_modules/admin-lte/bower_components/font-awesome/css/font-awesome.min.css",
              "node_modules/admin-lte/bower_components/fullcalendar/dist/fullcalendar.min.css",
              "node_modules/admin-lte/bower_components/fullcalendar/dist/fullcalendar.print.min.css"
            ],
            "scripts": [
              "node_modules/admin-lte/bower_components/jquery/dist/jquery.min.js",
              "node_modules/admin-lte/bower_components/bootstrap/dist/js/bootstrap.min.js",
              "node_modules/admin-lte/dist/js/adminlte.min.js",
              "node_modules/admin-lte/bower_components/moment/moment.js",
              "node_modules/admin-lte/bower_components/fullcalendar/dist/fullcalendar.min.js"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "HelpDesk:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "HelpDesk:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "HelpDesk:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "src/tsconfig.spec.json",
            "scripts": [
              "node_modules/admin-lte/bower_components/jquery/dist/jquery.min.js",
              "node_modules/admin-lte/bower_components/bootstrap/dist/js/bootstrap.min.js",
              "node_modules/admin-lte/dist/js/adminlte.min.js",
              "node_modules/admin-lte/bower_components/moment/moment.js",
              "node_modules/admin-lte/bower_components/fullcalendar/dist/fullcalendar.min.js"
            ],
            "styles": [
              "src/styles.css",
              "node_modules/admin-lte/bower_components/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/admin-lte/dist/css/AdminLTE.min.css",
              "node_modules/admin-lte/bower_components/Ionicons/css/ionicons.min.css",
              "node_modules/admin-lte/bower_components/font-awesome/css/font-awesome.min.css",
              "node_modules/admin-lte/bower_components/fullcalendar/dist/fullcalendar.min.css",
              "node_modules/admin-lte/bower_components/fullcalendar/dist/fullcalendar.print.min.css"
            ],
            "assets": [
              "src/assets",
              { "glob": "{favicon.svg,favicon-32.png,apple-touch-icon.png,site.webmanifest}", "input": "src", "output": "/" },
              { "glob": "*.png", "input": "src/icons", "output": "/icons" }
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "css",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "app",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
