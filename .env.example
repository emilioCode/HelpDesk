# Copy to .env before running `docker compose up`. Never commit .env.
# SQL Server requires at least 8 characters with upper, lower, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_123!
HELPDESK_PORT=8080

# Keys used by the API. Use long random values (at least 32 characters) and keep them secret.
# JWT_KEY signs the access tokens. SECRETS_KEY encrypts the companies' mail password in the database;
# changing it makes the stored mail passwords unreadable.
JWT_KEY=change-me-jwt-key-at-least-32-characters-long
SECRETS_KEY=change-me-secrets-key-at-least-32-characters

# When true the API rejects requests without a valid token. Keep false until the front end sends the token.
AUTH_ENFORCE=false
